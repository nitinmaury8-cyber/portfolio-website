# Is file ko copy karke .env naam do, phir apni real values bharo.
# .env ko kabhi GitHub par upload mat karna.

PORT=5000

# Frontend ka address (Vite dev server). Deploy ke baad apni site ka URL daalna.
CLIENT_ORIGIN=http://localhost:5173

# Gmail se bhejne ke liye
EMAIL_USER=your-gmail@gmail.com
# Gmail App Password (16 letters, normal password nahi)
EMAIL_PASS=xxxxxxxxxxxxxxxx

# Jis inbox me client ke messages chahiye (same Gmail bhi ho sakta hai)
EMAIL_TO=your-gmail@gmail.com
